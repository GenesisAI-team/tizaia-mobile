# Configuración del backend (modo demo). Nunca incluyas claves reales aquí.
PORT=3000
# Orígenes CORS separados por comas; `*` permite cualquier origen en demo.
CORS_ORIGINS=*
# Activa POST /v1/dev/reset (solo desarrollo).
ENABLE_DEV_RESET=false
# Modo demo explícito; no constituye una seguridad de producción.
DEMO_MODE=true

# ---------- Asistente (AI-001, RFC-001) ----------
# Proveedor compatible con AI SDK; primero aprobado: openai (@ai-sdk/openai).
AI_PROVIDER=openai
# Modelo configurable del proveedor elegido.
AI_MODEL=gpt-4o-mini
# Clave SOLO en el backend: sin ella, POST /v1/assistant/messages responde 503
# ASSISTANT_UNAVAILABLE y el resto de la API funciona con normalidad.
OPENAI_API_KEY=
# Pasos agénticos máximos por turno y timeout total en milisegundos.
AI_MAX_STEPS=6
AI_TIMEOUT_MS=30000
# Conversaciones en memoria: TTL y límite de mensajes por conversación.
CONVERSATION_TTL_MS=1800000
CONVERSATION_MAX_MESSAGES=24

# ---------- Traza de tools del asistente (issue #103) ----------
# Gated: SOLO con ASSISTANT_TRACE_ENABLED=true Y el header `x-assistant-trace`
# en la petición se añade metadata.trace (nombre + entrada de cada tool) a la
# respuesta. Nunca activado por defecto; la API por defecto no cambia.
ASSISTANT_TRACE_ENABLED=false

# ---------- Evaluador del asistente (issue #103) ----------
# El eval NO debe ejecutarse en CI. Para correr en local contra un backend:
#   ASSISTANT_EVAL_ALLOW_REAL=true pnpm --dir backend eval:assistant
ASSISTANT_EVAL_ALLOW_REAL=false
ASSISTANT_EVAL_BASE_URL=http://localhost:3000
ASSISTANT_EVAL_RUNS=1
ASSISTANT_EVAL_TIMEOUT_MS=35000
# Artefacto JSON de resultados (máquina-leyble); ignorado por .gitignore.
ASSISTANT_EVAL_OUT=eval-results/assistant-eval.json
