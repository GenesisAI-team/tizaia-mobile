# TizaIA mobile — plantilla de configuración pública del cliente Expo.
#
# Ubicación canónica del ejemplo de entorno: mobile/.env.example (este
# archivo). El .env que consume Expo también vive en mobile/: expo CLI
# resuelve los .env desde el directorio del proyecto, no desde la raíz del
# repositorio. Copiar la plantilla ejecutando desde mobile/:
#   Copy-Item .env.example .env
#
# Las variables EXPO_PUBLIC_* se inyectan en el bundle de la app: son valores
# públicos por diseño (viajan dentro del JavaScript que se envía al
# dispositivo). Nunca incluyas secretos, tokens ni claves privadas: la clave
# de Supabase aquí es la anon/publishable, no la service-role.
#
# Tras editar el .env, hacer full reload de la app para que Metro vuelva a
# construir el bundle con los nuevos valores.

# Backend propio en memoria (#67, RFC-001). Opcional en desarrollo Android:
# si se omite o queda vacía, la app usa el fallback
# `http://10.0.2.2:3000` (src/infrastructure/config/env.ts). Definirla para
# cambiar de entorno sin tocar código:
#
#   Android Emulator            http://10.0.2.2:3000
#   Dispositivo físico (LAN)    http://<IP-LAN-del-equipo>:3000
#   Backend desplegado (VPS)    https://<dominio-del-backend>
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# Credenciales públicas de Supabase (anon/publishable, no service_role).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Asistente (AI-001): «api» consume POST /v1/assistant/messages del backend
# propio; «fake» queda para desarrollo aislado y pruebas. Sin claves de IA
# aquí: la integración del asistente no lleva claves de proveedor.
EXPO_PUBLIC_ASSISTANT_MODE=api

# La autenticación Google se configura en el dashboard de Supabase; esta app
# no contiene client secrets.
