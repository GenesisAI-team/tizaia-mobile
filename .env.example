# Public client configuration only. Never put service-role keys or tokens here.
# Backend propio en memoria (#67). Android Emulator usa 10.0.2.2;
# iOS Simulator localhost; dispositivo fisico la IP LAN del equipo.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Asistente (AI-001): «api» consume POST /v1/assistant/messages del backend
# propio; «fake» queda para desarrollo aislado y pruebas. Sin claves de IA aqui.
EXPO_PUBLIC_ASSISTANT_MODE=api
# Configure Google in Supabase; this app does not contain client secrets.
